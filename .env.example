# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-side scripts only (seed, scheduled jobs). Never expose in the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- App ---
# Only these emails can sign in (comma-separated).
ALLOWED_EMAILS=tim@hermesmeyerinsurance.com
# Where magic-link emails send people back to. Change to your Netlify URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google (Phase 2; see "Google OAuth setup" in the README) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters, e.g. from: openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=

# --- Claude (optional; without it briefs and follow-ups use templates) ---
ANTHROPIC_API_KEY=
